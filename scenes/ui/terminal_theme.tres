[gd_resource type="Theme" load_steps=6 format=3]

[sub_resource type="SystemFont" id="SystemFont_mono"]
font_names = PackedStringArray("Consolas", "Lucida Console", "Courier New", "monospace")
font_weight = 600
multichannel_signed_distance_field = true

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_frame"]
bg_color = Color(0.035, 0.045, 0.045, 1)
border_width_left = 4
border_width_top = 4
border_width_right = 4
border_width_bottom = 4
border_color = Color(0.36, 0.38, 0.4, 1)
border_blend = true
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_card"]
bg_color = Color(0.08, 0.09, 0.1, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(1, 0.7, 0.2, 0.3)

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_card_focus"]
bg_color = Color(0.2, 0.14, 0.05, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(1, 0.7, 0.2, 1)

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_card_disabled"]
bg_color = Color(0.06, 0.065, 0.07, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(1, 1, 1, 0.1)

[resource]
default_font = SubResource("SystemFont_mono")
default_font_size = 14
Button/colors/font_color = Color(1, 0.7, 0.2, 1)
Button/colors/font_disabled_color = Color(1, 0.7, 0.2, 0.35)
Button/colors/font_focus_color = Color(1, 0.9, 0.6, 1)
Button/colors/font_hover_color = Color(1, 0.9, 0.6, 1)
Button/styles/disabled = SubResource("StyleBoxFlat_card_disabled")
Button/styles/focus = SubResource("StyleBoxFlat_card_focus")
Button/styles/hover = SubResource("StyleBoxFlat_card_focus")
Button/styles/normal = SubResource("StyleBoxFlat_card")
Button/styles/pressed = SubResource("StyleBoxFlat_card_focus")
Panel/styles/panel = SubResource("StyleBoxFlat_frame")
Label/colors/font_color = Color(1, 0.7, 0.2, 1)
Label/colors/font_outline_color = Color(0.05, 0.03, 0.02, 1)
Label/constants/outline_size = 2
