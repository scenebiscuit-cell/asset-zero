class_name SpreadCannonData
extends ModuleData
## Spread Cannon (from the HG-7 Gunship): a fan of rounds in Gunship form, a tight line in Lance form.

@export var rounds: int = 5
## Total width of the Gunship-form fan, in degrees.
@export var fan_degrees: float = 48.0
@export var round_speed: float = 850.0
## Lance form: rounds fly in one line, this many pixels apart.
@export var lance_spacing: float = 12.0
