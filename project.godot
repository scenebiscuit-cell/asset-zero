[internationalization]

locale/translations=PackedStringArray("res://data/translations/strings.en.translation")

[layer_names]

2d_physics/layer_1="player"
2d_physics/layer_2="player_bullets"
2d_physics/layer_3="enemies_air"
2d_physics/layer_4="enemies_ground"
2d_physics/layer_5="enemy_bullets"
2d_physics/layer_6="pickups"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.04, 0.05, 0.06, 1)
